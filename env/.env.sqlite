# PostgreSQL CDC Environment Configuration - SQLite Destination

# Rust Environment
RUST_LOG=info
RUST_BACKTRACE=1

# Source PostgreSQL Database Configuration
CDC_SOURCE_CONNECTION_STRING=postgresql://postgres:test.123@postgres:5432/postgres?replication=database

# Destination Database Configuration - SQLite
CDC_DEST_TYPE=SQLite
CDC_DEST_URI=/app/data/cdc_target.db

# No schema mapping needed for SQLite (schema is stripped automatically)

# CDC-Specific Configuration
CDC_REPLICATION_SLOT=cdc_slot
CDC_PUBLICATION=cdc_pub
CDC_STREAMING=true
CDC_CHANNEL_CAPACITY=1000
CDC_BATCH_SIZE=5000
CDC_BULK_INSERT_THRESHOLD=500

# Initial snapshot (opt-in, see README "Initial Snapshot"): copies existing table data on the
# first start with a fresh replication slot. Destination tables must already exist.
# SQLite always uses a single snapshot writer.
# CDC_INITIAL_SNAPSHOT=false
# CDC_SNAPSHOT_TARGET_POLICY=fail_if_not_empty
# CDC_SNAPSHOT_WRITERS=4
# CDC_SNAPSHOT_BUFFER_MB=16
# CDC_SNAPSHOT_BATCH_ROWS=20000

# Timeout Configuration (in seconds)
CDC_CONNECTION_TIMEOUT=30

# LSN Tracking and Position Persistence
CDC_LAST_LSN_FILE=./pg2any_last_lsn.metadata

# Monitoring Configuration
METRICS_PORT=8080

PG2ANY_ENABLE_COMPRESSION=true
